# Temporary / OS files
*.tmp
Thumbs.db
.DS_Store
*.log

# ======================
# Quartz Build Output
# ======================
quartz/public/
quartz/.quartz-cache/

# quartz/content is a junction to vault/ — handled by CI symlink step
quartz/content/

# Quartz internal docs (these cause massive slowdowns and recursion)
quartz/quartz/docs/
content/quartz/docs/

# Node modules
quartz/node_modules/

# ======================
# General
# ======================
*.bak
*.backup